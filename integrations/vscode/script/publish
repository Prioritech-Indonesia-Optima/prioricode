#!/usr/bin/env bash
set -euo pipefail

# Get the latest Git tag
latest_tag=$(git tag --sort=committerdate | grep -E '^vscode-v[0-9]+\.[0-9]+\.[0-9]+$' | tail -1)
if [ -z "$latest_tag" ]; then
    echo "No tags found"
    exit 1
fi
echo "Latest tag: $latest_tag"
version=$(echo "$latest_tag" | sed 's/^vscode-v//')
echo "Latest version: $version"

# package-marketplace
vsce package --no-git-tag-version --no-update-package-json --no-dependencies --skip-license -o dist/prioricode.vsix "$version"

# publish-marketplace (optional; skipped when VSCE_PAT is not set —
# upload dist/prioricode.vsix via https://marketplace.visualstudio.com/manage instead)
if [ -n "${VSCE_PAT:-}" ]; then
    vsce publish --packagePath dist/prioricode.vsix
else
    echo "VSCE_PAT not set; skipping marketplace publish"
fi

# publish-openvsx (optional; skipped when OPENVSX_TOKEN is not set)
if [ -n "${OPENVSX_TOKEN:-}" ]; then
    npx ovsx publish dist/prioricode.vsix -p "$OPENVSX_TOKEN"
else
    echo "OPENVSX_TOKEN not set; skipping Open VSX publish"
fi
