{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@prioricode/tui-core/solid",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@prioricode/tui-core": ["./src/index.ts"],
      "@prioricode/tui-core/solid": ["./src/solid/index.ts"],
      "@prioricode/tui-core/solid/jsx-runtime": ["./src/solid/jsx-runtime.ts"],
      "@prioricode/tui-core/solid/jsx-dev-runtime": ["./src/solid/jsx-dev-runtime.ts"]
    }
  }
}
