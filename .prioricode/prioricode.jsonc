{
  "$schema": "https://prioricode.ai/config.json",
  "provider": {},
  "permission": {},
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "prioricode-local": {
      "path": "~/.local/share/prioricode",
      "description": "Contains prioricode logs and data",
    },
  },
  "mcp": {},
  "worktree": {
    // branch-per-session is on by default; fresh session trees need deps so the
    // verify gate and package suites can actually run inside them.
    "setupCommand": "bun install",
    // the root `bun test` intentionally fails (per-package suites); land's merged-tree
    // gate uses the cheap all-packages typecheck here — release runs the suites.
    "verify": "bun run typecheck",
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
